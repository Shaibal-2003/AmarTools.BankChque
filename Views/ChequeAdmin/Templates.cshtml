@model List<AmarTools.Bankcheck.Models.ChequeTemplate>
@{
    ViewData["Title"] = "Bank Templates";
}

<div class="ck-page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="ck-page-icon"><i class="fas fa-layer-group"></i></div>
                <div>
                    <h1 class="ck-page-title">Bank Templates</h1>
                    <p class="ck-page-subtitle">Manage cheque leaf layouts for each bank</p>
                </div>
            </div>
            <a asp-action="CreateTemplate" class="ck-btn ck-btn-primary">
                <i class="fas fa-plus me-2"></i>Add Template
            </a>
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="row g-4">
        @foreach (var t in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="ck-template-card @(!t.IsActive ? "ck-template-inactive" : "")">
                    <div class="ck-template-header">
                        @if (!string.IsNullOrEmpty(t.LogoPath))
                        {
                            <img src="@t.LogoPath" alt="@t.BankName logo" class="ck-template-logo" />
                        }
                        else
                        {
                            <div class="ck-template-logo-placeholder"><i class="fas fa-university"></i></div>
                        }
                        <div>
                            <h5 class="ck-template-name">@t.BankName</h5>
                            <div class="ck-template-acct">A/C: @t.AccountNumber</div>
                        </div>
                        @if (t.IsActive)
                        {
                            <span class="ck-badge ck-badge-success ms-auto">Active</span>
                        }
                        else
                        {
                            <span class="ck-badge ck-badge-muted ms-auto">Inactive</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(t.ChequeImagePath))
                    {
                        <div class="ck-template-thumb">
                            <img src="@t.ChequeImagePath" alt="Cheque leaf" />
                        </div>
                    }

                    <div class="ck-template-meta">
                        <span><i class="fas fa-ruler-combined me-1"></i>@t.PageWidth×@t.PageHeight pt</span>
                        <span><i class="fas fa-calendar me-1"></i>@t.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="ck-template-actions">
                        <a asp-action="EditTemplate" asp-route-id="@t.Id" class="ck-btn ck-btn-sm ck-btn-secondary">
                            <i class="fas fa-edit me-1"></i>Edit Layout
                        </a>
                        <form method="post" asp-action="DeleteTemplate" asp-route-id="@t.Id"
                              onsubmit="return confirm('Delete this template?')" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ck-btn ck-btn-sm ck-btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="fas fa-layer-group" style="font-size:3rem;opacity:.2;"></i>
                <p class="mt-3">No templates yet. <a asp-action="CreateTemplate">Add one now.</a></p>
            </div>
        }
    </div>
</div>